{
  "version": "1.0",
  "created_at": "2026-01-22",
  "description": "Intent classification test cases",
  "test_cases": [
    {
      "id": "ic_001",
      "user_message": "Find jazz concerts in Berlin",
      "expected_action": "QUERY_DB",
      "conversation_history": [],
      "reasoning": "Has specific constraints (genre + location)"
    },
    {
      "id": "ic_002",
      "user_message": "Show me concerts",
      "expected_action": "NEEDS_INFO",
      "conversation_history": [],
      "reasoning": "Too vague, missing location/date/artist"
    },
    {
      "id": "ic_003",
      "user_message": "What's the weather like today?",
      "expected_action": "OUT_OF_SCOPE",
      "conversation_history": [],
      "reasoning": "Not about live music events"
    },
    {
      "id": "ic_004",
      "user_message": "Thanks, goodbye!",
      "expected_action": "BYE_MESSAGE",
      "conversation_history": [],
      "reasoning": "User ending conversation"
    },
    {
      "id": "ic_005",
      "user_message": "How do I book tickets for these events?",
      "expected_action": "OUT_OF_SCOPE",
      "conversation_history": [],
      "reasoning": "Booking is out of scope"
    },
    {
      "id": "ic_006",
      "user_message": "What about tomorrow?",
      "expected_action": "QUERY_DB",
      "conversation_history": [
        {"role": "user", "content": "Find jazz concerts in Berlin"},
        {"role": "assistant", "content": "I found 5 jazz concerts today"}
      ],
      "reasoning": "Context from history provides missing info"
    },
    {
      "id": "ic_007",
      "user_message": "Are there any Radiohead concerts?",
      "expected_action": "QUERY_DB",
      "conversation_history": [],
      "reasoning": "Artist-specific query, valid even without date/location"
    },
    {
      "id": "ic_008",
      "user_message": "What events are at Berghain?",
      "expected_action": "QUERY_DB",
      "conversation_history": [],
      "reasoning": "Venue-specific query"
    }
  ]
}
