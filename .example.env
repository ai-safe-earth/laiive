# laiive — root .env template. Copy to .env at the repo root.
# Both services load this file via SettingsConfigDict(env_file="../../.env"),
# resolved against CWD: always launch services from inside their own directory.

# ---- Neo4j Aura (required by retriever + pusher) ----
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io  # pragma: allowlist secret
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me  # pragma: allowlist secret
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=laiive

# ---- OpenAI (required) ----
OPENAI_API_KEY=sk-change-me  # pragma: allowlist secret
OPENAI_MODEL=gpt-4o                       # pusher conversation/extraction/vision
CLASSIFIER_MODEL=gpt-4o-mini              # retriever turn classifier
QUERY_BUILDER_MODEL=gpt-4o                # retriever NL->Cypher long tail
COMPOSER_MODEL=gpt-4o                     # retriever composer (tone-critical)
EMBEDDINGS_MODEL=text-embedding-3-small   # all services (1536-d)
ENABLE_MODERATION=true                    # OpenAI moderation endpoint (free)

# ---- Langfuse tracing (optional; retriever) ----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-change-me  # pragma: allowlist secret
LANGFUSE_SECRET_KEY=sk-lf-change-me  # pragma: allowlist secret
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Supabase (required by gateway; retriever eval_records and search
# reports read URL + service key, empty disables; see supabase/README.md) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me  # pragma: allowlist secret
SUPABASE_PUBLISHABLE_KEY=sb_publishable_change-me  # pragma: allowlist secret  (frontend, Phase 4)
SUPABASE_DATABASE_PASSWORD=change-me  # pragma: allowlist secret  (migrations only)

# ---- Gateway (services/gateway; loads this same file via ../../.env) ----
# GATEWAY_PORT=8000
# RETRIEVER_URL=http://localhost:8002
# PUSHER_URL=http://localhost:8003
# SEARCH_URL=http://localhost:8004
# SEARCH_ENABLED=false                    # gateway 503s /api/admin/search/* until "true"
# GATEWAY_HOST=0.0.0.0                    # "::" on Fly (6PN is IPv6-only)
CORS_ALLOW_ORIGINS=http://localhost:8081
# UPLOAD_MAX_BYTES=26214400               # cap on streamed upload routes
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_ANON_MAX=10                  # per IP per window (D7)
# RATE_LIMIT_USER_MAX=60
# RATE_LIMIT_PRO_MAX=120                  # the walk + the venue combobox
# RATE_LIMIT_ADMIN_MAX=240                # the dashboard + sweep polling                  # per user per window
# CONVERSATION_LOGGING=true

# ---- Search service (services/search, Phase 5; D13 revised: Tavily) ----
TAVILY_API_KEY=tvly-change-me  # pragma: allowlist secret
# SEARCH_EXTRACTION_MODEL=gpt-4o-mini
# SEARCH_EXTRACTION_FALLBACK_MODEL=gpt-4o
# SEARCH_SWEEP_MAX_PAGES=10
# SEARCH_RESULTS_PER_QUERY=5
# SEARCH_DEDUP_SIMILARITY=0.92

# ---- Internal boundary + shared state (Phase 6) ----
# INTERNAL_API_KEY=change-me              # gateway injects, services verify; unset = no-op (local dev)
# REDIS_URL=redis://localhost:6379/0      # rate limits + geocode cache/gate; unset = per-process fallback

# ---- Prefect flows (services/search/flows; see services/search/README.md) ----
# GATEWAY_URL=http://127.0.0.1:8000       # flows call the gateway, never the services
# SUPABASE_ADMIN_EMAIL=change-me          # admin service account (scripts/create_admin_user.py)
# SUPABASE_ADMIN_PASSWORD=change-me       # pragma: allowlist secret
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<acct>/workspaces/<ws>
# PREFECT_API_KEY=pnu_change-me           # pragma: allowlist secret  (containerized serve.py, and the search service's read-only scheduler panel)

# ---- Misc ----
# GEOCODE_CACHE_PATH=.geocode_cache.json   # pusher Nominatim cache (relative to services/pusher)
# HOST=0.0.0.0
# PORT is set per service by the launch command (retriever 8002, pusher 8003)
