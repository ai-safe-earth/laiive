# POSTGRES_USER=postgres_user # pragma: allowlist secret
# POSTGRES_PASSWORD=<your password> # pragma: allowlist secret
# POSTGRES_DB=laiive
# POSTGRES_PORT=5432
# POSTGRES_HOST=<db host> # pragma: allowlist secret

# POSTGRES_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# neo4j
NEO4J_URI=<neo4j+s://...>
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your password>
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=<instancec id>
AURA_INSTANCENAME=<instance name>

# LLM-APIs
OPENAI_API_KEY=<your api key>
OPENROUTER_API_KEY=<your api key>

# Core Models
# Query Builder: Converts natural language to Cypher queries (critical for search accuracy)
QUERY_BUILDER_MODEL=gpt-4o

# Embeddings: Used for semantic similarity ranking of results
EMBEDDINGS_MODEL=text-embedding-3-small

# Conversation Model
# Used for all conversation tasks: decision routing, guidance, result formatting, goodbyes
# Note: You can use a cheaper model like gpt-4o-mini if cost is a concern
CONVERSATIONAL_MODEL=gpt-4o

# Safety Model
# Used for all safety checks: input validation and output validation via LlamaGuard
SAFETY_MODEL=meta-llama/llama-guard-4-12b

# Safety Settings
# Enable output safety validation (disabled by default for better performance)
# Input safety is always enabled. Output safety adds ~500ms latency per response.
# ENABLE_OUTPUT_SAFETY_CHECK=false

# Internet Search
# Brave Search API key for web event discovery (runs in parallel with DB search)
# Get a free key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# INTERNET_SEARCH_MODEL=gpt-4o
# ENABLE_INTERNET_SEARCH=true


# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here  # pragma: allowlist secret
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
