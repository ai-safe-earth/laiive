# laiive — root .env template. Copy to .env at the repo root.
# Both services load this file via SettingsConfigDict(env_file="../../.env"),
# resolved against CWD: always launch services from inside their own directory.

# ---- Neo4j Aura (required by retriever + pusher) ----
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io  # pragma: allowlist secret
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me  # pragma: allowlist secret
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=laiive

# ---- OpenAI (required) ----
OPENAI_API_KEY=sk-change-me  # pragma: allowlist secret
OPENAI_MODEL=gpt-4o                       # pusher conversation/extraction/vision
CONVERSATIONAL_MODEL=gpt-4o               # retriever ReAct/composer
QUERY_BUILDER_MODEL=gpt-4o                # retriever NL->Cypher
EMBEDDINGS_MODEL=text-embedding-3-small   # both services (1536-d)

# ---- OpenRouter safety layer (required by retriever) ----
OPENROUTER_API_KEY=sk-or-change-me  # pragma: allowlist secret
SAFETY_MODEL=meta-llama/llama-guard-4-12b
ENABLE_OUTPUT_SAFETY_CHECK=false

# ---- Internet search (optional; retriever) ----
ENABLE_INTERNET_SEARCH=false
# BRAVE_SEARCH_API_KEY=change-me  # pragma: allowlist secret
# INTERNET_SEARCH_MODEL=gpt-4o

# ---- Langfuse tracing (optional; retriever) ----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-change-me  # pragma: allowlist secret
LANGFUSE_SECRET_KEY=sk-lf-change-me  # pragma: allowlist secret
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Misc ----
# REACT_MAX_LOOPS=5
# HOST=0.0.0.0
# PORT is set per service by the launch command (retriever 8002, pusher 8003)
